{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Zenit",
  "version": "1.9.3",
  "identifier": "com.zenit.app",
  "build": {
    "frontendDist": "../dist_app",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build:renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zenit",
        "url": "/index.html",
        "width": 1280,
        "height": 720,
        "resizable": false,
        "fullscreen": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "center": true,
        "focus": true,
        "devtools": false,
        "visible": false,
        "useHttpsScheme": true
      },
      {
        "label": "splashscreen",
        "title": "Zenit",
        "url": "/splash.html",
        "width": 450,
        "height": 350,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": true,
        "center": true,
        "useHttpsScheme": true
      },
      {
        "label": "return",
        "title": "Zenit Return",
        "url": "/return.html",
        "width": 240,
        "height": 200,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: stream: http://asset.localhost https://asset.localhost https://tauri.localhost http://tauri.localhost http://stream.localhost https://stream.localhost; img-src 'self' data: asset: http://asset.localhost https://asset.localhost https://tauri.localhost http://tauri.localhost; media-src 'self' asset: stream: http://asset.localhost https://asset.localhost https://tauri.localhost http://tauri.localhost http://stream.localhost https://stream.localhost; connect-src 'self' asset: stream: http://asset.localhost https://asset.localhost https://tauri.localhost http://tauri.localhost http://stream.localhost https://stream.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Rouchant",
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "icons/nsis/sidebar.bmp",
        "headerImage": "icons/nsis/header.bmp",
        "installerHooks": "nsis/hooks.nsh"
      },
      "wix": {
        "language": "es-ES",
        "bannerPath": "icons/wix/banner.bmp",
        "dialogImagePath": "icons/wix/dialogImagePath.bmp"
      }
    },
    "resources": {
      "resources/assets/**/*": "",
      "Install-Kiosk.ps1": "Install-Kiosk.ps1"
    }
  }
}